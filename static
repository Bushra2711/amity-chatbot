:root{
    --bg1:#fff8ed;
    --bg2:#e7f4ff;

    --glass:rgba(255,255,255,0.78);

    --text:#102033;
    --muted:#64748b;

    --blue1:#2563eb;
    --blue2:#0ea5e9;

    --green:#0f766e;

    --shadow:0 20px 50px rgba(0,0,0,0.12);
}

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:'Inter',sans-serif;

    min-height:100vh;

    background:
    radial-gradient(circle at top left,#ffe8b5,transparent 30%),
    radial-gradient(circle at bottom right,#bde0ff,transparent 30%),
    linear-gradient(135deg,var(--bg1),var(--bg2));

    color:var(--text);

    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:stretch;

    overflow-x:hidden;
    overflow-y:auto;  
 padding:20px;
}

.page-shell{
    width:100%;
    min-height:100vh;
    padding:20px;
    box-sizing:border-box;
}
/*Dashboard*/

.chat-app{
    width:100%;
    max-width:1400px;

    height:calc(100vh - 40px);

    margin:0 auto;

    display:grid;

    grid-template-columns:300px 1fr;

    gap:18px;
}

/* SIDEBAR */

.hero-panel{
    width:100%;
    height:100%;

    overflow:hidden;
}

/* BRAND */

.brand{
    display:flex;
    align-items:center;
    gap:14px;
}

.logo{
    width:65px;
    height:65px;
    object-fit:contain;
}

.brand h2{
    font-size:20px;
}

.brand p{
    color:var(--muted);
    margin-top:4px;
}

/* TEXT */

.eyebrow{
    display:inline-block;

    margin-top:20px;

    background:#d9f4ef;

    color:#0b5b55;

    padding:10px 14px;

    border-radius:999px;

    font-size:12px;

    font-weight:700;
}

.hero-panel h1{
    margin-top:24px;

    font-size:22px;

    line-height:1.15;

    max-width:300px;

    overflow-wrap:break-word;

    font-weight:800;
}

.hero-panel p{
    margin-top:20px;

    line-height:1.7;

    color:var(--muted);
}

/* LEFT BUTTONS */

.sidebar-actions{
    margin-top:30px;

    display:flex;
    flex-direction:column;

    gap:14px;
}

.sidebar-btn{
    border:none;

    border-radius:18px;

    padding:18px;

    font-size:18px;

    font-weight:700;

    color:white;

    cursor:pointer;

    background:linear-gradient(135deg,var(--blue1),var(--blue2));

    transition:.3s;

    box-shadow:0 12px 25px rgba(37,99,235,0.25);
}

.sidebar-btn:hover{
    transform:translateY(-3px);
}

/* CHAT PANEL */

.chat-panel{
    width:100%;
    min-width:0;
}

/* HEADER */

.chat-header{
    padding:22px;

    border-bottom:1px solid rgba(0,0,0,0.06);

    display:flex;
    justify-content:space-between;
    align-items:center;
}

.chat-title{
    display:flex;
    gap:14px;
    align-items:center;
}

.status-dot{
    width:14px;
    height:14px;

    border-radius:50%;

    background:#10b981;
}

.chat-title h2{
    font-size:28px;
}

.chat-title p{
    color:var(--muted);
    margin-top:4px;
}

/* CHAT AREA */

.messages{
    flex:1;

    overflow-y:auto;

    overflow-x:hidden;

    padding:22px;

    display:flex;

    flex-direction:column;

    gap:18px;
    
    scroll-behavior:smooth;
}

/* MESSAGE */

.message{
    display:flex;
}

.user-message{
    justify-content:flex-end;
}

.bot-message{
    justify-content:flex-start;
}

.message-bubble{
    max-width:75%;

    word-wrap:break-word;

    overflow-wrap:break-word;

    padding:18px;

    border-radius:20px;

    line-height:1.7;

    box-shadow:0 8px 24px rgba(0,0,0,0.08);
}

.bot-message .message-bubble{
    background:#eef5ff;
}

.user-message .message-bubble{
    background:#dff7df;
}

/* TIME */

.message-meta{
    margin-top:10px;

    font-size:12px;

    color:#64748b;
}

/* LANGUAGE */

.language-selector{
    display:flex;

    justify-content:center;

    gap:12px;

    padding:16px;
}

.quick-btn{
    border:none;

    border-radius:14px;

    padding:12px 20px;

    color:white;

    font-weight:700;

    cursor:pointer;

    background:linear-gradient(135deg,var(--blue1),var(--blue2));
}

/* DETAIL CARD */

.specialization-detail-card{
    background:white;

    grid-column: 1 / -1;
    margin:0;

    padding:24px;

    border-radius:22px;

    box-shadow:0 10px 30px rgba(0,0,0,0.08);
}

.detail-grid{
    display:grid;
    grid-template-columns:1fr;
    gap:14px;
}

.detail-item{
    display:flex;
    flex-direction:column;
    gap:4px;
}

.detail-item span{
    font-size:13px;
    font-weight:700;
    color:var(--muted);
}

.detail-item strong{
    font-size:16px;
    line-height:1.6;
}

.detail-item-full{
    grid-column:1 / -1;
}

.detail-meta{
    margin-top:14px;
}

.specialization-detail-card h3{
    font-size:32px;
    margin-bottom:16px;
}

.specialization-detail-card p{
    line-height:1.8;
    margin-bottom:12px;
}

/* INPUT */

.composer{
    display:flex;

    gap:14px;

    padding:20px;

    border-top:1px solid rgba(0,0,0,0.06);

    background:rgba(255,255,255,0.9);
}

#messageInput{
    flex:1;

    height:60px;

    border:none;

    border-radius:18px;

    padding:0 18px;

    font-size:16px;

    outline:none;

    background:white;

    box-shadow:0 0 0 2px rgba(14,165,233,0.1);
}

#sendButton{
    width:120px;

    border:none;

    border-radius:18px;

    color:white;

    font-size:16px;

    font-weight:700;

    cursor:pointer;

    background:linear-gradient(135deg,#0f766e,#14b8a6);
}

/* MOBILE */

@media(max-width:900px){

.chat-header
{
    padding:16px;
}

.chat-title h2{
    font-size:20px;
}

.chat-title p{
    font-size:13px;
}

.messages{
    padding:14px;
}

.message-bubble{
    max-width:95%;
    padding:14px;
    font-size:14px;
}

.composer{
    padding:14px;
}

#messageInput{
    height:52px;
    font-size:14px;
}

#sendButton{
    width:90px;
    font-size:14px;
}

.specialization-panel{
    grid-template-columns:1fr;
    max-height:280px;
}

.spec-card{
    padding:14px;
}

.spec-btn{
    font-size:14px;
    padding:12px;
 }
}

/* DARK MODE */

body.dark-mode{
    background:
    radial-gradient(circle at top left,#1a1a2e,transparent 30%),
    radial-gradient(circle at bottom right,#16213e,transparent 30%),
    linear-gradient(135deg,#0f172a,#111827);

    color:white;
}

body.dark-mode .hero-panel,
body.dark-mode .chat-panel{
    background:rgba(15,23,42,0.92);
}

body.dark-mode .hero-panel h1,
body.dark-mode .chat-title h2,
body.dark-mode .brand h2{
    color:white;
}

body.dark-mode p{
    color:#cbd5e1;
}

body.dark-mode .message-bubble{
    color:white;
}

body.dark-mode .bot-message .message-bubble{
    background:#1e293b;
}

body.dark-mode .user-message .message-bubble{
    background:#134e4a;
}

body.dark-mode #messageInput{
    background:#1e293b;
    color:white;
}

body.dark-mode .specialization-detail-card{
    background:#1e293b;
    color:white;
}

.language-buttons{
    display:flex;
    gap:12px;
    margin-top:18px;
}

.lang-btn{
    border:none;
    padding:10px 22px;
    border-radius:14px;
    cursor:pointer;
    font-weight:600;
    color:white;

    background:linear-gradient(
        135deg,
        #2563eb,
        #0ea5e9
    );

    transition:0.3s;
}

.lang-btn:hover{
    transform:translateY(-2px);
}

.specialization-panel{
    display:grid;

    grid-template-columns:1fr 1fr;

    gap:16px;

    padding:0 20px 20px;

    width:100%;

    overflow-y:auto;

    max-height:320px;
}

.hidden{
    display:none !important;
}

.spec-card{
    background:#ffffff;
    border-radius:18px;

    padding:18px;

    box-shadow:0 6px 20px rgba(0,0,0,0.08);

    transition:0.3s;
}

.spec-card:hover{
    transform:translateY(-4px);
}

.spec-btn{
    width:100%;

    padding:14px;

    border:none;

    border-radius:14px;

    font-size:16px;
    font-weight:600;

    color:white;

    cursor:pointer;

    background:linear-gradient(
        135deg,
        #2563eb,
        #0ea5e9
    );
}

/* Admission link styling */
.admission-link{
    display:inline-block;
    padding:10px 16px;
    background-color:#ff6b35;
    color:#ffffff;
    text-decoration:none;
    border-radius:8px;
    font-weight:700;
    transition:background-color 0.2s ease, transform 0.15s ease;
}
.admission-link:hover{
    background-color:#ff5722;
    transform:translateY(-2px);
}
/* TYPING INDICATOR */
.typing-bubble {
    display: flex;
    align-items: center;
    gap: 3px;
    padding: 16px 20px !important;
}

.dot {
    animation: typing 1.2s infinite;
}

@keyframes typing {
    0%, 100% { opacity: 0.3; }
    50% { opacity: 1; }
}

.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }
/* TYPING INDICATOR - Final Fix */
.typing-bubble {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 16px 22px !important;
    min-width: 80px;
}

.dot {
    animation: typingDot 1.4s infinite ease-in-out;
    font-weight: bold;
}

@keyframes typingDot {
    0%, 100% { opacity: 0.2; transform: translateY(0); }
    50% { opacity: 1; transform: translateY(-2px); }
}

.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }
